# ---- Server-only. Copy to .env.local (gitignored) and fill in. ----
# Never prefix any of these with NEXT_PUBLIC_ and never commit real values.

# Required. Permanent Gemini API key. Used only by POST /api/live-token on the
# server to mint short-lived ephemeral tokens; it is never sent to the browser.
GEMINI_API_KEY=

# Optional. Live API model. Defaults to gemini-3.8-live when empty.
# Verified 2026-11-01 against https://ai.google.dev/gemini-api/docs/models
# ("Gemini 3.8 Live" -> gemini-3.8-live). The token endpoint only accepts models
# on the allowlist in src/lib/server/env.ts; any other value is rejected with a
# server-side configuration error rather than being passed to Google.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional. Comma-separated extra origins allowed to call /api/live-token, e.g.
# "https://visionaid.example.com". Same-origin requests (including through a
# tunnel such as ngrok, via X-Forwarded-Host) are always allowed.
ALLOWED_ORIGINS=
