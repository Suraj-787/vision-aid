# ---- Server-only. Copy to .env.local (gitignored) and fill in. ----
# Never prefix any of these with NEXT_PUBLIC_ and never commit real values.

# Required. Permanent Gemini API key. Used only on the server: by POST /api/ask
# (Tap-to-Ask, from Milestone 5) and POST /api/live-token (optional Live Mode).
# It is never sent to the browser.
GEMINI_API_KEY=

# Tap-to-Ask model (read from Milestone 5; not used by the app yet).
# A Gemini Flash-family model ID with image input and structured outputs.
# Do not assume any model is free or has quota: confirm in Google AI Studio
# (https://aistudio.google.com/rate-limit) that the exact model is available to
# your project, its tier, and its RPM/TPM/RPD limits. Candidate IDs noted in
# docs/model-and-quota-notes.md are observations, not guarantees.
GEMINI_MODEL=

# Optional Live Mode feature flag. Must be exactly "true" to enable
# POST /api/live-token; any other value (or unset) keeps it disabled and it
# mints no tokens. Tap-to-Ask does not need Live Mode.
ENABLE_LIVE_MODE=false

# Optional Live Mode only (POST /api/live-token). Defaults to gemini-3.8-live
# when empty; must be on the allowlist in src/lib/server/env.ts.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional. Comma-separated extra origins allowed to call the API routes, e.g.
# "https://visionaid.example.com". Same-origin requests (including through a
# tunnel such as ngrok, via X-Forwarded-Host) are always allowed.
ALLOWED_ORIGINS=

# Optional, Milestone 7, only if Sarvam speech-to-text is approved. Server-only.
SARVAM_API_KEY=
